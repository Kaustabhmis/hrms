# Where eTimeTrackLite keeps its data. On the machine running the eSSL
# software this is usually localhost; from another machine, MySQL has to be
# allowed to accept a remote connection and the user granted rights from it.
ESSL_DB_HOST=127.0.0.1
ESSL_DB_PORT=3306
ESSL_DB_USER=hrms_readonly
ESSL_DB_PASSWORD=
ESSL_DB_NAME=etimetracklite

# Table and column names. Run "node sync.js --probe" first — eTimeTrackLite has
# shipped several schemas and these defaults are the common ones, not a promise.
ESSL_TABLE=DeviceLogs
ESSL_COL_ID=DeviceLogId
ESSL_COL_USER=UserId
ESSL_COL_STAMP=LogDate
ESSL_COL_DIRECTION=Direction
ESSL_COL_DEVICE=DeviceId

ESSL_BATCH=50000
ESSL_OUT_DIR=./out
